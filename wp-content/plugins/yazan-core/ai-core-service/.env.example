# YAZAN AI Core — service configuration.
# Copy to .env and set a strong shared secret that MATCHES the one saved in
# WordPress → /dashboard → AI Settings → "AI Core (remote service)".

# Port the service listens on (WordPress AI Core URL points here, e.g. http://127.0.0.1:8787).
PORT=8787

# Bind address. 127.0.0.1 for local dev; 0.0.0.0 behind a reverse proxy in production.
HOST=127.0.0.1

# Shared secret used to sign/verify every request (HMAC-SHA256). Keep it long and random.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
YAZAN_CORE_SECRET=change-me-to-a-long-random-string

# Max clock skew (seconds) allowed between WordPress and this service for the replay window.
SIGNATURE_WINDOW=300
